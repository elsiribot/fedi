# .env - Environment variables for the project
#
# Instructions:
# - Replace the placeholder values below with the actual secrets.
# - DO NOT COMMIT this file after populating it with real values.
# - Ensure the `.env` file is ignored by Git to prevent accidental commits.

# Zendesk Android Channel Key
CHANNEL_KEY_ANDROID=dummy_android_key

# Zendesk iOS Channel Key
CHANNEL_KEY_IOS=dummy_ios_key

# Zendesk Secret Key
ZENDESK_SECRET_KEY=dummy_zendesk_secret_key

# Zendesk KID
ZENDESK_KID=dummy_zendesk_kid
