{
  "compilerOptions": {
    "strict": true,
    "module": "CommonJS",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "composite": true
  },
  "include": [
    "./**/*.tsx",
    "./**/*.ts",
  ],
  "exclude": ["node_modules"]
}
