[Error]
enum FedimintError {
  "ClientError",
  "AnyhowError",
};

namespace calculator {
  [Throws=FedimintError]
  void fedimint_init(string data_dir);

  [Throws=FedimintError]
  string fedimint_generate_invoice(string amount, string description);

  [Throws=FedimintError]
  void fedimint_pay_invoice(string invoice);

  u64 fedimint_balance();

  string fedimint_generate_address();
};
