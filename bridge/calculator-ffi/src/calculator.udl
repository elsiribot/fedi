[Error]
enum FedimintError {
  "ClientError",
  "AnyhowError",
  "WalletClientError",
  "InvalidAddress",
};

namespace calculator {
  [Throws=FedimintError]
  void fedimint_init(string data_dir, EventSink event_sink);

  [Throws=FedimintError]
  string fedimint_generate_invoice(string amount, string description);

  [Throws=FedimintError]
  void fedimint_pay_invoice(string invoice);

  u64 fedimint_balance();

  string fedimint_generate_address();

  [Throws=FedimintError]
  string fedimint_pay_address(string address, string amount);

};

callback interface EventSink {
  void event(string event_type, string body);
};